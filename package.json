{
  "name": "@tetherto/dev-websites-core",
  "version": "0.3.4",
  "description": "Shared CMS, SEO, i18n, utils, UI, and analytics primitives for the WDK / QVAC / PEAR / MDK websites.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/dev-websites-core.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./cms": {
      "types": "./dist/cms/index.d.mts",
      "import": "./dist/cms/index.mjs",
      "default": "./dist/cms/index.mjs"
    },
    "./cms/google-oauth": {
      "types": "./dist/cms/google-oauth.d.mts",
      "import": "./dist/cms/google-oauth.mjs",
      "default": "./dist/cms/google-oauth.mjs"
    },
    "./seo": {
      "types": "./dist/seo/index.d.mts",
      "import": "./dist/seo/index.mjs",
      "default": "./dist/seo/index.mjs"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.mts",
      "import": "./dist/i18n/index.mjs",
      "default": "./dist/i18n/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "import": "./dist/utils/index.mjs",
      "default": "./dist/utils/index.mjs"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.mts",
      "import": "./dist/analytics/index.mjs",
      "default": "./dist/analytics/index.mjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.mts",
      "import": "./dist/ui/index.mjs",
      "default": "./dist/ui/index.mjs"
    },
    "./ui/a11y": {
      "types": "./dist/ui/a11y/index.d.mts",
      "import": "./dist/ui/a11y/index.mjs",
      "default": "./dist/ui/a11y/index.mjs"
    },
    "./ui/carousel": {
      "types": "./dist/ui/carousel/index.d.mts",
      "import": "./dist/ui/carousel/index.mjs",
      "default": "./dist/ui/carousel/index.mjs"
    },
    "./ui/theme.css": "./src/ui/theme/theme.css",
    "./ui/theme/tokens.css": "./src/ui/theme/tokens.css",
    "./ui/theme/preset.css": "./src/ui/theme/preset.css",
    "./ui/theme/preset": "./src/ui/theme/preset.ts",
    "./ui/google-oauth.css": "./src/ui/google-oauth.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/ui/theme",
    "src/ui/google-oauth.css"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepare": "tsdown",
    "prepublishOnly": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,mjs,md}\""
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@next/third-parties": ">=15",
    "@payloadcms/richtext-lexical": "^3.85.1",
    "@payloadcms/storage-s3": "^3.85.1",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-primitive": "^2.0.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "embla-carousel-react": "^8.0.0",
    "google-auth-library": "^11.1.0",
    "next": ">=15",
    "payload": "^3.85.1",
    "react": ">=19",
    "react-dom": ">=19",
    "react-icons": "^5.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@next/third-parties": {
      "optional": true
    },
    "embla-carousel-react": {
      "optional": true
    },
    "google-auth-library": {
      "optional": true
    },
    "react-icons": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@eslint/js": "^9.39.0",
    "@next/third-parties": "^16.3.2",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-primitive": "^2.1.4",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "google-auth-library": "^11.1.0",
    "next": "^16.2.6",
    "payload": "3.88.0",
    "prettier": "^3.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.67.0",
    "unrun": "^0.3.1"
  },
  "overrides": {
    "dompurify": "^3.4.14",
    "fast-uri": "^3.1.6"
  }
}
